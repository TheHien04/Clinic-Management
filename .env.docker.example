# Copy to .env in repo root for: docker compose up --build
# cp .env.docker.example .env

# SQL Server (must meet complexity rules for MSSQL image)
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Backend secrets (local Docker only; never reuse these in production)
JWT_SECRET=dev-docker-jwt-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=dev-docker-refresh-secret-min-32-ch!!

# For production, use a secret manager and set NODE_ENV=production. The API
# rejects weak/reused secrets, wildcard CORS, and unencrypted database links.

# Hybrid health-data read model. SQL Server remains the source of truth;
# MongoDB stores privacy-minimized FHIR-inspired clinical events.
ENABLE_MONGO=true
MONGO_DB_NAME=ClinicManagement
MONGO_ROOT_PASSWORD=local-mongo-password-change-me

# Optional: set SKIP_DB_MIGRATE=1 in docker-compose if you run migrations manually
# SKIP_DB_MIGRATE=0
